import { getDb } from '../../lib/db'

export default function handler(req, res) {
  const db = getDb()

  if (req.method === 'GET') {
    const row = db.prepare('SELECT * FROM company_profile WHERE id = 1').get()
    return res.json(row || {})
  }

  if (req.method === 'POST') {
    const { name, vat, cr, city, address } = req.body
    const existing = db.prepare('SELECT id FROM company_profile WHERE id = 1').get()
    if (existing) {
      db.prepare('UPDATE company_profile SET name=?,vat=?,cr=?,city=?,address=?,updated_at=CURRENT_TIMESTAMP WHERE id=1')
        .run(name, vat, cr, city, address)
    } else {
      db.prepare('INSERT INTO company_profile (id,name,vat,cr,city,address) VALUES (1,?,?,?,?,?)')
        .run(name, vat, cr, city, address)
    }
    return res.json({ success: true })
  }

  res.status(405).end()
}
